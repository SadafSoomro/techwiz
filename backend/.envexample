# ---------------------------------------------------------------
# FANDOM VERSE - backend environment template
# Copy this file to `.env` and fill in your own values:
#     copy .envexample .env        (Windows PowerShell)
# ---------------------------------------------------------------

# Server
PORT=5000

# JWT signing secret (used by the auth + community + events + shop modules)
JWT_SECRET=

# Gmail SMTP for OTP / verification / password-reset emails.
# EMAIL_PASS must be a 16-character Gmail App Password (not your login password).
EMAIL_USER=
EMAIL_PASS=

# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------
# MEMBER 5 - AI Fan Helper (OPTIONAL)
# Leave blank to use the built-in offline FAQ engine - no key required.
# Fill in to forward unanswered questions to an OpenAI-compatible API.
# ---------------------------------------------------------------
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
