# Copy this file to `.env` (backend/.env) and fill in real values.
# `.env` is gitignored - never commit real credentials.

# ---- Server ----
PORT=5000

# ---- Auth (Member 1) ----
# Any long random string. Changing it invalidates existing login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Google Sign-In (Member 1) ----
# OAuth 2.0 Web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=
# Not read by the current backend code (ID-token verification only needs the
# client ID) - kept for parity with the Google Cloud console credentials.
GOOGLE_CLIENT_SECRET=

# ---- Email / OTP delivery (Member 1) ----
# Gmail address + 16-character Gmail "App Password" (not your normal password).
EMAIL_USER=
EMAIL_PASS=

# ---- AI Fan Helper (Member 5) ----
# Optional. Leave AI_API_URL / AI_API_KEY empty to keep the AI helper on its
# local catalogue + FAQ engine only (it still answers, just without tier 3).
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- Not read by the current backend code (reserved for future features) ----
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
