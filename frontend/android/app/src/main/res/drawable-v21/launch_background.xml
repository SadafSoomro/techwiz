<?xml version="1.0" encoding="utf-8"?>
<!-- Launch background: the FANDOM VERSE key art over the brand midnight blue,
     so start-up shows artwork + loading instead of a bare colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0F19" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash_art" />
    </item>
</layer-list>
